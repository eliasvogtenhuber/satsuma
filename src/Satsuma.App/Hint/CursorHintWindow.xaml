<Window x:Class="Satsuma.App.Hint.CursorHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SizeToContent="WidthAndHeight">

    <!-- A label at the pointer's elbow, saying what Satsuma is waiting for.

         Not frosted, unlike every other surface here. The glass elsewhere is a
         photograph of what the window covers, and this one moves with the cursor, so
         the photograph would be wrong a frame after it was taken. A solid pill that is
         right is better than a frosted one that smears. -->

    <Border x:Name="Pill"
            CornerRadius="15" Height="30"
            Background="#E8151515"
            BorderBrush="#40FFFFFF" BorderThickness="1">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <Path x:Name="Glyph"
                  Stroke="#E8E8E8" StrokeThickness="1.3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0" />

            <TextBlock x:Name="Caption"
                       FontSize="12" Foreground="#F2F2F2"
                       VerticalAlignment="Center"
                       Margin="8,0,13,0" />

            <!-- Only in the mode where no key is being held, which is the only mode
                 with a free hand to click it. -->
            <Border x:Name="Accept"
                    Width="34" CornerRadius="0,14,14,0"
                    Background="#1AFFFFFF"
                    BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0"
                    Margin="-5,0,0,0"
                    Cursor="Hand"
                    Visibility="Collapsed">
                <Path x:Name="Tick"
                      Stroke="#F2F2F2" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </StackPanel>
    </Border>
</Window>
