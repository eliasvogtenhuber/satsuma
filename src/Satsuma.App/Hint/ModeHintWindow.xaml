<Window x:Class="Satsuma.App.Hint.ModeHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="46" Height="46">

    <!-- The same glass as the wheel and the cards, at the smallest size it still reads
         at. This one is click-through: it appears while the user is about to click a
         folder, and a hint that caught that click would be the one thing it must not
         do. -->

    <Grid>
        <Border CornerRadius="13" Background="#8A000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                                  Opacity="0.5" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="13" ClipToBounds="True">
            <Image x:Name="Backdrop" Stretch="Fill" CacheMode="BitmapCache">
                <Image.Effect>
                    <BlurEffect Radius="20" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Border>

        <Border x:Name="Scrim" CornerRadius="13" />

        <Border CornerRadius="13" BorderBrush="#4DFFFFFF" BorderThickness="1" />

        <Grid>
            <Grid.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.85" Color="Black" />
            </Grid.Effect>

            <Path x:Name="Glyph"
                  Stroke="#EDEDED" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- While files are being gathered the count replaces the mark, since by
                 then how many is the only thing left worth saying. The arrow under it
                 is the way out. -->
            <StackPanel x:Name="Tally"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="Count"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="#FAFAFA" TextAlignment="Center"
                           Margin="0,0,0,1" />
                <Path x:Name="Confirm"
                      Stroke="#9EFFFFFF" StrokeThickness="1.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
