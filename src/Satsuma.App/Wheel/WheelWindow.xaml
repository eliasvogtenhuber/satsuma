<Window x:Class="Satsuma.App.Wheel.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="348" Height="348">

    <!-- Background is deliberately null rather than Transparent. A transparent brush is
         still hit-testable in WPF, which would make the whole square swallow the drag;
         null lets everything outside the painted slices pass through to what is beneath.

         There is no disc. Every layer here is clipped to the union of the slice shapes
         plus the hub, so the wheel is a ring of separate floating panes rather than a
         plate with wedges scored into it. A full circle anywhere, whether backdrop,
         scrim or outline, shows up as a halo around the slices and reads as crowding
         them. -->

    <Grid x:Name="RootGrid" Background="{x:Null}">

        <!-- Lifts the panes off the desktop. Shares the slice geometry, so the shadow
             falls around each pane rather than around a circle. -->
        <Path x:Name="ShadowShape" Fill="#9E000000" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270"
                                  Opacity="0.46" Color="#000000" />
            </Path.Effect>
        </Path>

        <!-- The frost: a photograph of what the wheel covers, blurred, clipped to the
             panes.

             Both layers are bitmap-cached. The capture never changes while the wheel is
             open, so the blur is worth computing once: without the cache, every change of
             Clip re-runs a large Gaussian over the whole window, and moving between panes
             drops frames badly enough to read as flicker. -->
        <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False"
               CacheMode="BitmapCache">
            <Image.Effect>
                <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>

        <!-- The same photograph blurred much harder, clipped to whichever pane is
             selected. Deepening the frost is how a selection reads when no accent colour
             is doing the work.

             Kept loaded rather than collapsed, so selecting a pane only moves a clip on
             an already-rendered layer instead of forcing the hard blur to be computed
             again from nothing. -->
        <Image x:Name="BackdropDeep" Stretch="Fill" IsHitTestVisible="False"
               CacheMode="BitmapCache">
            <Image.Effect>
                <BlurEffect Radius="76" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>

        <!-- Panes, labels and the hit catcher, all generated in code: a radial layout is
             geometry rather than markup. -->
        <Canvas x:Name="SegmentLayer" Background="{x:Null}" />

        <!-- The hub, made of the same glass as the panes rather than a dark well with a
             ring around it. -->
        <Grid x:Name="Hub" Width="92" Height="92"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsHitTestVisible="False">
            <Ellipse x:Name="HubBase" />
            <Ellipse x:Name="HubFilm" />

            <StackPanel VerticalAlignment="Center" Margin="9,0">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.85" Color="Black" />
                </StackPanel.Effect>
                <TextBlock x:Name="HubPrimary"
                           Text="Satsuma"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FAFAFA"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HubSecondary"
                           Text=""
                           FontSize="9.5"
                           Foreground="#B0B0B0"
                           TextAlignment="Center"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="26" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
