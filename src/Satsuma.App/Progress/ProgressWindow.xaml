<Window x:Class="Satsuma.App.Progress.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="330" Height="92">

    <Border CornerRadius="10" Background="#F21A1A1A" BorderBrush="#2BFFFFFF" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="14,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="0"
                       Text="Working"
                       FontSize="13.5" FontWeight="SemiBold" Foreground="#F5F5F5"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="CancelButton"
                       Grid.Row="0" Grid.Column="1"
                       Text="&#xE711;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11" Foreground="#9C9C9C"
                       Cursor="Hand" Margin="8,2,0,0"
                       ToolTip="Cancel" />

            <TextBlock x:Name="DetailText"
                       Grid.Row="1" Grid.ColumnSpan="2"
                       Text=""
                       FontSize="11" Foreground="#9C9C9C"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />

            <ProgressBar x:Name="Bar"
                         Grid.Row="2" Grid.ColumnSpan="2"
                         Height="4" Minimum="0" Maximum="1" Value="0"
                         Margin="0,9,0,0"
                         Background="#26FFFFFF" Foreground="#F08A3D"
                         BorderThickness="0" />
        </Grid>
    </Border>
</Window>
