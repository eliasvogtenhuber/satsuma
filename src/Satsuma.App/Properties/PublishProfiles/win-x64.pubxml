<?xml version="1.0" encoding="utf-8"?>
<!--
  The shipping build.

  Self-contained on purpose. Windows 11 does not carry the .NET 8 Desktop Runtime, so a
  framework-dependent build asks the user to go and install one before the tray icon ever
  appears — which is the kind of errand Satsuma exists to remove. It costs about 150MB,
  and WPF cannot be trimmed, so that is the floor rather than something to tune.

  Not single-file: ffmpeg lives in a tools\ folder beside the exe anyway, so the result is
  a folder either way, and single-file WPF pays for itself by unpacking native libraries
  into temp on every start.

  Used as: dotnet publish src\Satsuma.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Precompiled to native code ahead of time. The first wheel is already prewarmed at
         startup; this is about the startup itself, which is what the user waits on after
         logging in. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trimming is unsupported for WPF: it reflects over XAML-generated types and strips
         them out from under itself. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- File names are not all in one language, so ICU stays. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
