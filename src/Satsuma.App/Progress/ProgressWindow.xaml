<Window x:Class="Satsuma.App.Progress.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="326" Height="96">

    <!-- Same glass as the wheel: a blurred photograph of what the card covers, a scrim
         weighted to how bright that is, a thin rim, and text carrying its own shadow so
         the tint never has to be heavy. -->

    <Grid Margin="10">
        <Grid.Resources>
            <CornerRadius x:Key="Radius">14</CornerRadius>
        </Grid.Resources>

        <!-- Lifts the card off whatever is behind it. -->
        <Border CornerRadius="14" Background="#8A000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270"
                                  Opacity="0.45" Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- The frost. Clipped by the border it sits in. -->
        <Border CornerRadius="14" ClipToBounds="True">
            <Image x:Name="Backdrop" Stretch="Fill" CacheMode="BitmapCache">
                <Image.Effect>
                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Border>

        <Border x:Name="Scrim" CornerRadius="14" />

        <Border CornerRadius="14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#24FFFFFF" />
                    <GradientStop Offset="0.5" Color="#12FFFFFF" />
                    <GradientStop Offset="1" Color="#0AFFFFFF" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border CornerRadius="14" BorderBrush="#4DFFFFFF" BorderThickness="1" />

        <Grid Margin="15,12">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.85" Color="Black" />
            </Grid.Effect>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="0"
                       Text="Working"
                       FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="CancelButton"
                       Grid.Row="0" Grid.Column="1"
                       Text="&#xE711;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="11" Foreground="#B0B0B0"
                       Cursor="Hand" Margin="8,2,0,0"
                       ToolTip="Cancel" />

            <TextBlock x:Name="DetailText"
                       Grid.Row="1" Grid.ColumnSpan="2"
                       Text=""
                       FontSize="11" Foreground="#B8B8B8"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />

            <!-- Drawn rather than a ProgressBar: the stock control brings its own chrome,
                 which is the part that looked out of place next to the wheel. -->
            <Grid x:Name="BarTrack" Grid.Row="2" Grid.ColumnSpan="2" Height="3" Margin="0,11,0,0"
                  HorizontalAlignment="Stretch">
                <Border CornerRadius="1.5" Background="#2EFFFFFF" />
                <Border x:Name="BarFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#E8FFFFFF" />
                            <GradientStop Offset="1" Color="#FFFFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
