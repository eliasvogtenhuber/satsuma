<Window x:Class="Satsuma.App.Prompt.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="360" Height="160">

    <!-- The same glass as the wheel and the progress card. Unlike those, this one does
         take focus: by the time it appears the drop has happened and the drag is over,
         and it cannot be typed into otherwise.

         Height is a starting point, not the final one: the hint wraps, so how tall the
         card needs to be depends on the question. ShowAtCursor measures the content and
         sets the real height before showing. -->

    <Grid x:Name="Root" Margin="10">
        <Border CornerRadius="14" Background="#8A000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270"
                                  Opacity="0.5" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" ClipToBounds="True">
            <Image x:Name="Backdrop" Stretch="Fill" CacheMode="BitmapCache">
                <Image.Effect>
                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Border>

        <Border x:Name="Scrim" CornerRadius="14" />

        <Border CornerRadius="14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#24FFFFFF" />
                    <GradientStop Offset="0.5" Color="#12FFFFFF" />
                    <GradientStop Offset="1" Color="#0AFFFFFF" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border CornerRadius="14" BorderBrush="#4DFFFFFF" BorderThickness="1" />

        <StackPanel Margin="18,16" VerticalAlignment="Center">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.85" Color="Black" />
            </StackPanel.Effect>

            <TextBlock x:Name="TitleText"
                       Text="Resize to"
                       FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" />

            <TextBlock x:Name="HintText"
                       Text=""
                       FontSize="10.5" Foreground="#B0B0B0"
                       Margin="0,3,0,0" TextWrapping="Wrap" />

            <Border x:Name="FieldBorder" CornerRadius="7" Margin="0,11,0,0"
                    Background="#38000000" BorderBrush="#4DFFFFFF" BorderThickness="1">
                <TextBox x:Name="Field"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                         SelectionBrush="#66FFFFFF"
                         FontSize="14" Padding="10,7" MinHeight="34"
                         VerticalContentAlignment="Center" />
            </Border>

            <TextBlock x:Name="FooterText"
                       Text="Enter to apply, Esc to cancel"
                       FontSize="9.5" Foreground="#8C8C8C"
                       Margin="0,9,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
