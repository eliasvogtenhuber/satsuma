<Window x:Class="Satsuma.App.Shelf.FloatShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma shelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="252">

    <Border CornerRadius="10" Background="#F21A1A1A" BorderBrush="#2BFFFFFF" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="0,8,0,10">

            <!-- Drag anywhere on the strip to move the shelf. -->
            <Grid x:Name="TitleBar" Margin="12,0,10,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Shelf" FontSize="12" FontWeight="SemiBold" Foreground="#C8C8C8"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="CloseButton"
                           Grid.Column="1"
                           Text="&#xE711;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="11" Foreground="#8C8C8C"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="Empty the shelf" />
            </Grid>

            <ItemsControl x:Name="Items" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1FFFFFFF" CornerRadius="6" Margin="0,2" Padding="9,6"
                                Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12" Foreground="#EDEDED"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}"
                                           FontSize="9.5" Foreground="#8C8C8C"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Drag items off the shelf"
                       FontSize="9.5" Foreground="#787878"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
