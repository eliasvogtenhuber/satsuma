<Window x:Class="Satsuma.App.Shelf.FloatShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satsuma shelf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Width="258">

    <!-- The same glass as the wheel, the prompt and the progress card: a photograph of
         what it covers, blurred, tinted to suit, under one gradient and one hairline.
         It was the only surface in Satsuma that was a flat dark panel, which is what
         made it look like it came from a different program.

         Unlike the others this one is moved by hand and outlives the gesture that made
         it, so the photograph is taken again whenever it lands somewhere new. -->

    <Grid x:Name="Root" Margin="10">
        <Border CornerRadius="14" Background="#8A000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270"
                                  Opacity="0.5" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" ClipToBounds="True">
            <Image x:Name="Backdrop" Stretch="Fill" CacheMode="BitmapCache">
                <Image.Effect>
                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
        </Border>

        <Border x:Name="Scrim" CornerRadius="14" />

        <Border CornerRadius="14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#24FFFFFF" />
                    <GradientStop Offset="0.5" Color="#12FFFFFF" />
                    <GradientStop Offset="1" Color="#0AFFFFFF" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border CornerRadius="14" BorderBrush="#4DFFFFFF" BorderThickness="1" />

        <StackPanel Margin="0,9,0,11">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.85" Color="Black" />
            </StackPanel.Effect>

            <!-- Drag anywhere on the strip to move the shelf. -->
            <Grid x:Name="TitleBar" Margin="14,0,9,7" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Shelf" FontSize="12" FontWeight="SemiBold" Foreground="#FAFAFA"
                           VerticalAlignment="Center" />

                <!-- A Border rather than a bare glyph. A TextBlock with no background is
                     only hit-testable where its strokes actually are, so the old close
                     button had to be hit on the two-pixel cross itself and read as
                     unclickable. -->
                <Border x:Name="CloseButton"
                        Grid.Column="1"
                        Width="22" Height="22" CornerRadius="6"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="Close the shelf. The files stay on it.">
                    <Path Data="M1,1 L10,10 M10,1 L1,10"
                          Stroke="#C8C8C8" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <ItemsControl x:Name="Items" Margin="9,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1FFFFFFF" CornerRadius="8" Margin="0,2" Padding="10,6"
                                BorderBrush="#1AFFFFFF" BorderThickness="1"
                                Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12" Foreground="#EDEDED"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}"
                                           FontSize="9.5" Foreground="#9A9A9A"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="FooterText"
                       Text="Click to open, or drag it off"
                       FontSize="9.5" Foreground="#8C8C8C"
                       HorizontalAlignment="Center" Margin="0,9,0,0" />
        </StackPanel>
    </Grid>
</Window>
